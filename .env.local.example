# Internal Go API address. This is server-only and must never use a
# NEXT_PUBLIC_ prefix. Next.js rewrites browser /v1 requests here.
API_INTERNAL_URL=http://localhost:5050

# Public canonical origin used for metadata and absolute URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Header set by the trusted hosting proxy and used for server-side API calls.
# The helper validates one IP and overwrites X-Forwarded-For/X-Real-IP.
TRUSTED_CLIENT_IP_HEADER=x-real-ip
